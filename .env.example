# Runtime: select ollama for the new model-distribution path. Auto retains the v0.5 platform
# defaults (MLX on Apple Silicon and Transformers elsewhere); mock is a UI smoke test.
# Set CYBERSLM_ENV_FILE before startup to load a different environment file.
CYBERSLM_MODEL_BACKEND=auto
# Leave blank for the selected backend's Gemma 3 default, or provide a model ID/local path.
CYBERSLM_MODEL_ID=
CYBERSLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
CYBERSLM_OLLAMA_TIMEOUT=600
CYBERSLM_OLLAMA_CONTEXT_SIZE=4096
CYBERSLM_TRANSFORMERS_DEVICE=auto
CYBERSLM_TRANSFORMERS_REVISION=main
CYBERSLM_TRANSFORMERS_QUANTIZATION=none
CYBERSLM_ADAPTER_PATH=
CYBERSLM_MAX_TOKENS=1024
CYBERSLM_TEMPERATURE=0.2
# Optional absolute or relative directory for training artifacts and local knowledge.
CYBERSLM_DATA_DIR=
CYBERSLM_RAG_ENABLED=true
CYBERSLM_RAG_SEMANTIC_ENABLED=true
CYBERSLM_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CYBERSLM_RAG_RESULTS=4
CYBERSLM_RAG_MAX_CHARS=16000
ORT_DISABLE_TELEMETRY=1
